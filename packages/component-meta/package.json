{
  "name": "@orca/component-meta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "meta:extract": "tsx scripts/extract-props.ts",
    "meta:check": "tsx scripts/extract-props.ts && git -C ../.. diff --exit-code packages/component-meta/src/generated",
