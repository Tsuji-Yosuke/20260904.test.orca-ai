{
  "name": "@orca/react",
  "version": "0.0.0",
  "private": true,
  "description": "orca デザインシステムの React コンポーネント実装",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run && pnpm run feedback:check",
    "test:watch": "vitest",
    "feedback:capture": "node scripts/capture-component-feedback.mjs",
    "feedback:check": "node --test scripts/test-validate-component-feedback.mjs scripts/test-capture-component-feedback.mjs && node scripts/validate-component-feedback.mjs",
    "feedback:list": "node scripts/list-component-feedback.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@orca/token-pipeline": "workspace:*",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@storybook/react": "^8.4.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.4.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}
